{
  "name": "ice24-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ICE24 OS modular monolith workspace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:review && pnpm check:boundaries && pnpm check:infra && pnpm check:identity && pnpm check:colors && pnpm check:contrast && pnpm check:catalog && pnpm test",
    "check:catalog": "node scripts/check-ui-catalog.mjs",
    "check:boundaries": "node scripts/check-workspace-dependencies.mjs",
    "check:colors": "node scripts/check-color-literals.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:identity": "node scripts/check-phase3-identity.mjs",
    "check:infra": "node scripts/check-phase2-infrastructure.mjs",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @ice24/api dev",
    "dev:private": "pnpm --filter @ice24/private-web dev",
    "dev:public": "pnpm --filter @ice24/public-portal dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "local:infra": "supabase start",
    "local:infra:stop": "supabase stop",
    "local:mocks": "docker compose --profile mocks up -d",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "node scripts/ui-quality/run.mjs",
    "test:ui:update": "node scripts/ui-quality/run.mjs --update-snapshots",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "typecheck": "turbo run typecheck",
    "typecheck:review": "tsc -p tsconfig.review.json",
    "ux:snapshots": "tsx scripts/ux-snapshots/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.10.3",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "pg": "8.23.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.1",
    "supabase": "2.115.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
