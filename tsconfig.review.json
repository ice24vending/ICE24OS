{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    ".storybook/*.ts",
    "packages/ui/src/**/*.stories.tsx",
    "packages/ui/src/foundations/**/*.tsx",
    "packages/ui/src/**/*.test.ts",
    "apps/private-web/src/**/*.stories.tsx",
    "tests/visual/**/*.ts",
    "scripts/ux-snapshots/**/*.ts",
    "scripts/generate-tokens.ts"
  ]
}
