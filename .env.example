# Copia este archivo a .env y completa los valores locales. No uses secretos reales.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3003
PDF_WORKER_PORT=3004
PRIVATE_WEB_PORT=3000
PUBLIC_PORTAL_PORT=3002
LOCAL_POSTGRES_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# ClamAV INSTREAM. Sin escáner disponible, las evidencias quedan en cuarentena.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Worker F5-09 (file_scans): clamav (predeterminado si CLAMAV_HOST existe) o simulated
# (solo development/test; marca como infectado únicamente el archivo de prueba EICAR).
FILE_SCANNER=
FILE_SCAN_TIMEOUT_MS=30000
OIDC_ISSUER=
OIDC_AUDIENCE=authenticated
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
PRIVATE_API_URL=http://127.0.0.1:3001/v1
PRIVATE_WEB_URL=http://127.0.0.1:3000
BFF_API_SHARED_SECRET=
# Mínimo 32 caracteres aleatorios; usa un valor diferente por ambiente.
BFF_SESSION_SECRET=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Stripe F5-02: solo servidor. Usar credenciales de prueba fuera de producción.
# La configuración se valida al construir el cliente; aún no está conectado al arranque.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precio recurrente mensual en MXN. Valor inicial del plan: 39900 centavos.
STRIPE_PRICE_ID=
# Opcional: vacío usa la configuración predeterminada del portal.
STRIPE_PORTAL_CONFIGURATION_ID=
# PRIVATE_WEB_URL define el origen autorizado de retorno. No publicar secretos en NEXT_PUBLIC_*.
