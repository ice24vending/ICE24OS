# Copia este archivo a .env y completa los valores locales. No uses secretos reales.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3003
PDF_WORKER_PORT=3004
PRIVATE_WEB_PORT=3000
PUBLIC_PORTAL_PORT=3002
LOCAL_POSTGRES_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=authenticated
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
