{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ICE24_STORAGE_ORIGIN", "SUPABASE_URL", "NEXT_PUBLIC_ICE24_OFFLINE_SHELL"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/offline-work/**",
        "public/sw.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["scripts/build-offline.mjs", "scripts/offline-cache.mjs"]
}
