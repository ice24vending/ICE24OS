{
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-utils.tsx",
    "src/foundations/**",
    "src/components/base/stories-kit.tsx",
    "src/patterns/layouts/stories-kit.tsx",
    "src/stories/**"
  ]
}
